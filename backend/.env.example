# Server
NODE_ENV=development
PORT=4001

# PostgreSQL (matches docker/docker-compose.yml)
DATABASE_URL="postgresql://rwog:rwog_dev_password@localhost:5432/renewed_world_of_games?schema=public"

# Redis (matches docker/docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth — used in Phase 1 (must be at least 32 characters)
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — frontend origin
CORS_ORIGIN="http://localhost:4000"
